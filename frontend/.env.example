# For local development with Vite proxy, leave empty or set http://localhost:3000
# For production deployment on Vercel/Netlify (separate from backend), set your deployed backend API URL:
# Example: VITE_API_URL=https://matrientry-api.onrender.com
VITE_API_URL=http://localhost:3000

# Optional: target URL for Vite's local dev server /api proxy (defaults to http://localhost:3000)
VITE_API_PROXY_TARGET=http://localhost:3000
