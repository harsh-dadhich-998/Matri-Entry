# Server-only settings. Never expose secrets through VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
APP_URL=http://localhost:3000
PORT=3000

# Required for account credential emails.
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=MatriEntry <support@example.com>

# Set to production on the deployment host.
NODE_ENV=development
